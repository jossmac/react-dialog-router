{
  "name": "dialog-router-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @jossmac/dialog-router-docs dev",
    "build": "pnpm --filter @jossmac/dialog-router build && pnpm --filter @jossmac/dialog-router-docs build",
    "check:lint": "oxlint",
    "check:types": "pnpm -r run check:types",
    "check:format": "oxfmt --check",
    "check:all": "pnpm check:lint && pnpm check:types && pnpm check:format",
    "format": "oxfmt",
    "preview": "pnpm --filter @jossmac/dialog-router-docs preview",
    "storybook": "pnpm --filter @jossmac/dialog-router-docs storybook",
    "build-storybook": "pnpm --filter @jossmac/dialog-router-docs build-storybook"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "24",
    "pnpm": "12"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
